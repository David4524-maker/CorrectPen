{
  "manifest_version": 3,
  "name": "CorrectPen",
  "version": "1.0",
  "description": "Autocorrector inteligente para ES, EN y PT.",
  "default_locale": "es",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CorrectPen"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}